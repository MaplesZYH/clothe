# 运行环境：development（本地）、test（测试）、production（线上）
NODE_ENV=development

# ==================== Supabase / 数据库 ====================
# Supabase 项目地址，用于登录、私有文件存储和数据库服务
NEXT_PUBLIC_SUPABASE_URL=
# 浏览器端 Supabase 公钥，只能使用 anon key，不要填 service role key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端 Supabase 管理密钥，只能放在服务端环境变量，绝不能暴露给浏览器
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL 连接串，Worker 和服务端任务会用它读写任务队列
DATABASE_URL=
# 匿名用户身份 cookie 的签名密钥，生产环境请换成至少 32 字节随机字符串
ANONYMOUS_SESSION_SECRET=replace-with-a-random-32-byte-secret

# ==================== 统一 AI Agent ====================
# 同一个 Agent 的供应商/协议。stub=本地模拟；http=调用你的 AI 服务
AI_PROVIDER=stub
# 当 AI_PROVIDER=http 时填写 Agent 服务的接口地址
AI_ENDPOINT=
# 当 AI_PROVIDER=http 时填写 Agent API Key。该 Key 同时用于下面两个调用阶段
AI_API_KEY=
# Agent 使用的模型名称
AI_MODEL=gpt-5.6-terra
# 阶段一：上传衣物后，请 Agent 抠图、去背景、识别品类并生成透明衣物卡
# 阶段二：用户点击建议后，请同一个 Agent 分析画板并给出搭配建议

# 每批衣物图片处理成功前预扣的积分数量
GARMENT_PROCESSING_CREDITS=1
# 每次生成搭配建议报告扣除的积分数量
STYLING_ADVICE_CREDITS=1
